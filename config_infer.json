{
    "name": "Test Setting",
    "n_gpu": 1,
    "gpu": "cuda:0",
    "resume": "saved/mit_bih/20250727-173342/model_best(epoch14).pth",
    "output_dir": "outputs/",
    "arch": {
        "type": "simple1dcnn",
        "args": {}
    },
    "data_loader": {
        "type": "mit_bih",
        "setting": {
            "input_channels": 1,
            "n_classes": 3
        },
        "args":{
            "split": "test",
            "data_dir": "data/mit_bih",
            "batch_size": 512,
            "preprocess": {"_resample_rate": 250,
                            "_denoise": {
                                "bpf": [0.5, 40],
                                "median": [200, 600],
                                "median_mode": "double"  
                            },
                            "_normalize": "minmax",
                            "_augmentation": {
                                "noise": 0.01
                            }
                          },
            "xy_method": "simple",
            "shuffle": "False",
            "validation_split": 0.0,
            "num_workers": 2
        }
    },
    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.004,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": {
        "type": "ce",
        "alpha": 0.25,
        "gamma": 2.0
    },
    "log_dir": "logs/",
    "metrics": [
        "accuracy_multiclass", "sensitivity_macro",
        "precision_macro", "f1_score_macro"
    ],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 5,
            "gamma": 0.1
        }
    },
    "trainer": {
        "epochs": 100,

        "save_dir": "saved/",
        "save_period": 1,
        "verbosity": 2,
        
        "monitor": "max sensitivity",
        "early_stop": 10
    }
}
